# .env.example — Copy this to .env and fill in your keys.
# Never commit .env to version control.

# ── LLM API Keys ──────────────────────────────────────────────────────────────

# Gemini (Explorer + Evaluator agents)
# Free tier: https://ai.google.dev/
GEMINI_API_KEY='YOUR_GEMINI_API_KEY_HERE'

# Optional: comma-separated keys for round-robin on rate limits, e.g.
#   GEMINI_API_KEYS=key_from_project_a,key_from_project_b
# IMPORTANT: Gemini free-tier rate limits are per GOOGLE CLOUD PROJECT,
# not per key — keys from the SAME project share one quota pool and
# adding more of them here will NOT add any capacity. Each key must come
# from a genuinely separate project for this to help. If unset, falls
# back to the single GEMINI_API_KEY above.
# GEMINI_API_KEYS=

# Groq (Mutator agent — Llama 4 Scout or Qwen3 32B)
# Free tier: https://console.groq.com/
GROQ_API_KEY='YOUR_GROQ_API_KEY_HERE'

# ── Target ────────────────────────────────────────────────────────────────────

# ⚠️  Only set this to a system you OWN or have WRITTEN PERMISSION to test.
# Recommended starting targets (intentionally vulnerable):
#   OWASP Juice Shop: docker run -p 3000:3000 bkimminich/juice-shop
#   WebGoat:          docker run -p 8080:8080 webgoat/goat-and-wolf
TARGET_URL=http://localhost:3000
