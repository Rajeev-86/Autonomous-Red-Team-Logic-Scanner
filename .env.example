# .env.example — Copy this to .env and fill in your keys.
# Never commit .env to version control.

# ── LLM API Keys ──────────────────────────────────────────────────────────────

# Gemini 2.5 Flash (Explorer + Evaluator agents)
# Free tier: https://ai.google.dev/
GEMINI_API_KEY='YOUR_GEMINI_API_KEY_HERE'

# Groq (Mutator agent — Llama 4 Scout or Qwen3 32B)
# Free tier: https://console.groq.com/
GROQ_API_KEY='YOUR_GROQ_API_KEY_HERE'

# ── Target ────────────────────────────────────────────────────────────────────

# ⚠️  Only set this to a system you OWN or have WRITTEN PERMISSION to test.
# Recommended starting targets (intentionally vulnerable):
#   OWASP Juice Shop: docker run -p 3000:3000 bkimminich/juice-shop
#   WebGoat:          docker run -p 8080:8080 webgoat/goat-and-wolf
TARGET_URL=http://localhost:3000
