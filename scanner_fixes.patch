+def _field_name(key: str) -> str:
+    """
+    Extract the matchable field name from a flattened key, stripping any
+    trailing array-index suffix, e.g. "items[0].price" -> "price",
+    "user_ids[2]" -> "user_ids".
+    """
+    return re.sub(r"\[\d+\]$", "", key.split(".")[-1])
+
